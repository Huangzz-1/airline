APP_NAME="Airline Smart"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
DB_CONNECTION=mysql
DB_HOST=db2
DB_PORT=3306
DB_DATABASE=airline
DB_USERNAME=airline
DB_PASSWORD=
DB1_HOST=db1
DB3_HOST=db3
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
CACHE_STORE=file
QUEUE_CONNECTION=database
MAIL_MAILER=smtp
MAIL_FROM_ADDRESS=noreply@airline.test
MAIL_FROM_NAME="Airline Smart"
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack

# Email delivery. Set MAIL_MAILER=smtp and supply deployment credentials.
MAIL_SCHEME=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_TIMEOUT=10
MAIL_USERNAME=
MAIL_PASSWORD=
# Use MAIL_SCHEME=smtps with port 465 when required by the provider.

# Payment simulation is disabled for application users.
PAYMENT_SIMULATOR_ENABLED=false
AIRLINE_SAMPLE_DATA=false
VNPAY_ENABLED=true
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
MOMO_ENABLED=true
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_URL=https://test-payment.momo.vn
BANK_TRANSFER_ENABLED=true
BANK_NAME=
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_NAME=

# Local providers use these modes; switch to gateway/live for deployment.
PAYMENT_MODE=mock
BANK_TRANSFER_MODE=mock
DB_ROOT_PASSWORD=
APP_PORT=8000
TRUSTED_PROXIES=
SESSION_SECURE_COOKIE=false
AIRLINE_BOOTSTRAP_ADMIN=true
LOCAL_ADMIN_EMAIL=admin@airline.test
LOCAL_ADMIN_PASSWORD=
